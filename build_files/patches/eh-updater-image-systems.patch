+/// Image systems: the staged image applies at boot, so restart reboots.
+pub fn rebootSystem(io: std.Io) bool {
+    const argv = [_][]const u8{ "systemctl", "reboot" };
+    _ = std.process.spawn(io, .{
+        .argv = &argv,
+        .stdin = .ignore,
+        .stdout = .ignore,
+        .stderr = .ignore,
+    }) catch return false;
+    return true;
+}
