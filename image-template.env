# Parameters for the image-template Justfile.
# REPO_ORGANIZATION is only used in OCI labels (source URLs). The registry
# path GitHub Actions pushes to is ghcr.io/<the account that owns the repo>.

IMAGE_NAME=bazzite-horizon
REPO_ORGANIZATION=CipherVLT

IMAGE_DESC="Bazzite with the Event Horizon shell on a Hyprland session"
IMAGE_KEYWORDS="bootc,bazzite,hyprland,event-horizon,ublue,gaming"
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
