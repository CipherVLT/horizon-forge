#!/usr/bin/env bash
# Copy the current ostree deployment into a systemd-boot menu entry on the ESP.
#
# ostree writes a Boot Loader Specification file under /boot/loader/entries and
# leaves the kernel on /boot. systemd-boot cannot read that partition when it
# is btrfs or an ext4 that is not the ESP, so the file has to be copied onto
# the EFI system partition or the menu stays empty.
#
# The Anaconda ISO calls this from its kickstart. The systemd unit calls it
# again on boot and on shutdown, after ostree has staged an update, so the
# menu does not keep an old kernel.
#
# This script refuses to write an entry it cannot prove will boot. A wrong
# entry on the ESP is worse than no entry, because systemd-boot is first in
# the firmware boot order and the user lands in dracut emergency mode. The
# checks are:
#   * the options line carries root=
#   * when the root filesystem is a btrfs subvolume, the options line carries
#     rootflags=subvol= (added here if ostree/Anaconda left it out)
#   * the ostree= path named in the options line exists on the physical root
#     (/sysroot), so the entry matches the deployment that is really on disk
# Any of these failing exits non-zero, which aborts the kickstart %post
# (--erroronfail) instead of producing a disk that cannot boot.
set -euo pipefail

log() { echo "bazzite-horizon: $*" >&2; }

esp=/boot/efi
if [[ ! -d "$esp" ]]; then
    log "no ESP at ${esp}, skipping systemd-boot entry"
    exit 0
fi

shopt -s nullglob
mapfile -t entries < <(ls -1t /boot/loader/entries/*.conf 2>/dev/null || true)
if [[ ${#entries[@]} -eq 0 ]]; then
    log "no ostree boot entry yet, will retry next boot"
    exit 0
fi

title=$(head -n 1 /usr/share/bazzite-horizon/boot-title 2>/dev/null || true)
if [[ -z "${title}" ]]; then
    title=$(sed -n 's/^BOOTLOADER_NAME=//p' /usr/lib/os-release 2>/dev/null | head -n 1 | tr -d '"')
fi
title=${title:-Bazzite Horizon}

# Where the physical root (the filesystem that holds /ostree) is visible.
# On a booted ostree system that is /sysroot. Inside the Anaconda %post
# chroot it is also /sysroot (Anaconda bind-mounts it there). Fall back to /
# so a plain container build still gets a sensible answer.
physroot=/
if [[ -d /sysroot/ostree ]]; then
    physroot=/sysroot
fi

# Return "subvol name" when $physroot sits on a btrfs subvolume, else nothing.
root_subvol() {
    local fstype opts subvol
    fstype=$(findmnt -no FSTYPE -T "$physroot" 2>/dev/null || true)
    [[ "$fstype" == "btrfs" ]] || return 0
    opts=$(findmnt -no OPTIONS -T "$physroot" 2>/dev/null || true)
    subvol=$(tr ',' '\n' <<<"$opts" | sed -n 's/^subvol=//p' | head -n 1)
    # findmnt reports the subvolume as a path (/root). The kernel wants the
    # bare name relative to the top level (root).
    subvol=${subvol#/}
    # A bind mount of a deployment reports subvol=/root/ostree/deploy/... ;
    # keep only the top-level subvolume.
    subvol=${subvol%%/*}
    printf '%s\n' "$subvol"
}

resolve_boot_file() {
    local rel=$1
    if [[ -f "/boot${rel}" ]]; then
        printf '%s\n' "/boot${rel}"
        return 0
    fi
    if [[ -f "${rel}" ]]; then
        printf '%s\n' "${rel}"
        return 0
    fi
    return 1
}

# Validate (and if needed repair) the kernel options line copied from ostree.
# Prints the final options line.
check_options() {
    local opts=$1 src=$2 subvol ostree_path

    if ! grep -Eq '(^|[[:space:]])root=' <<<"$opts"; then
        log "${src}: options line has no root= argument, refusing to write a systemd-boot entry"
        log "options were: ${opts}"
        return 1
    fi

    subvol=$(root_subvol)
    if [[ -n "$subvol" ]] && ! grep -Eq '(^|[[:space:]])rootflags=' <<<"$opts"; then
        log "${src}: root is btrfs subvolume '${subvol}' but options lack rootflags=; adding rootflags=subvol=${subvol}"
        opts="${opts} rootflags=subvol=${subvol}"
    fi

    ostree_path=$(tr ' ' '\n' <<<"$opts" | sed -n 's/^ostree=//p' | head -n 1)
    if [[ -z "$ostree_path" ]]; then
        log "${src}: options line has no ostree= argument, refusing to write a systemd-boot entry"
        return 1
    fi
    if [[ "$physroot" == /sysroot && ! -e "/sysroot${ostree_path}" ]]; then
        log "${src}: ostree=${ostree_path} does not exist under /sysroot; this entry does not match the deployment on disk"
        log "deployments present: $(ls -d /sysroot/ostree/boot.*/*/*/* 2>/dev/null | tr '\n' ' ')"
        return 1
    fi

    printf '%s\n' "$opts"
}

write_entry() {
    local src=$1 dest=$2 menutitle=$3
    local linux initrd opts version src_linux src_initrd tmp
    linux=$(awk '$1 == "linux" { print $2; exit }' "$src")
    initrd=$(awk '$1 == "initrd" { print $2; exit }' "$src")
    version=$(awk '$1 == "version" { print $2; exit }' "$src")
    opts=$(awk '$1 == "options" { sub(/^options[[:space:]]+/, ""); print; exit }' "$src")
    if [[ -z "${linux}" || -z "${opts}" ]]; then
        log "${src} has no linux/options"
        return 1
    fi
    opts=$(check_options "$opts" "$src") || return 1

    src_linux=$(resolve_boot_file "$linux") || {
        log "kernel ${linux} from ${src} is not on /boot"
        return 1
    }
    src_initrd=""
    if [[ -n "${initrd}" ]]; then
        src_initrd=$(resolve_boot_file "$initrd") || {
            log "initrd ${initrd} from ${src} is not on /boot"
            return 1
        }
    fi

    install -d "${esp}/bazzite-horizon" "${esp}/loader/entries"
    install -m 0644 "$src_linux" "${esp}/bazzite-horizon/${dest}-vmlinuz"
    if [[ -n "${src_initrd}" ]]; then
        install -m 0644 "$src_initrd" "${esp}/bazzite-horizon/${dest}-initramfs.img"
    fi

    # Write the entry last and atomically, so a half-written file is never
    # the one systemd-boot reads.
    tmp="${esp}/loader/entries/.${dest}.conf.tmp"
    {
        printf 'title %s\n' "$menutitle"
        if [[ -n "${version}" ]]; then
            printf 'version %s\n' "$version"
        fi
        printf 'linux /bazzite-horizon/%s-vmlinuz\n' "$dest"
        if [[ -n "${src_initrd}" ]]; then
            printf 'initrd /bazzite-horizon/%s-initramfs.img\n' "$dest"
        fi
        printf 'options %s\n' "$opts"
    } > "$tmp"
    mv -f "$tmp" "${esp}/loader/entries/${dest}.conf"
    log "wrote ${esp}/loader/entries/${dest}.conf"
    log "options ${opts}"
}

write_entry "${entries[0]}" "bazzite-horizon" "$title"

if [[ ${#entries[@]} -gt 1 ]]; then
    # A second kernel plus initrd can fill a small EFI partition. Skip the
    # rollback row rather than abort the boot when there is not room.
    avail_kb=$(df -Pk "$esp" | awk 'NR == 2 { print $4 }')
    if [[ "${avail_kb:-0}" -gt 800000 ]]; then
        write_entry "${entries[1]}" "bazzite-horizon-rollback" "${title} (rollback)" || \
            rm -f "${esp}/loader/entries/bazzite-horizon-rollback.conf"
    else
        rm -f "${esp}/loader/entries/bazzite-horizon-rollback.conf" \
            "${esp}/bazzite-horizon/bazzite-horizon-rollback-vmlinuz" \
            "${esp}/bazzite-horizon/bazzite-horizon-rollback-initramfs.img"
    fi
else
    rm -f "${esp}/loader/entries/bazzite-horizon-rollback.conf" \
        "${esp}/bazzite-horizon/bazzite-horizon-rollback-vmlinuz" \
        "${esp}/bazzite-horizon/bazzite-horizon-rollback-initramfs.img"
fi

if [[ ! -f "${esp}/loader/loader.conf" ]]; then
    # editor yes while the image is being brought up: it lets you fix the
    # kernel line from the systemd-boot menu (press e) instead of booting a
    # rescue USB. Flip to "editor no" once installs are reliably booting.
    cat > "${esp}/loader/loader.conf" <<'EOF'
default bazzite-horizon.conf
timeout 5
console-mode keep
editor yes
EOF
fi

if command -v bootctl >/dev/null 2>&1; then
    bootctl --esp-path="$esp" install || \
        log "bootctl install did not set the firmware entry; the menu files are still on the ESP"
fi

log "systemd-boot entry is ${title}"
