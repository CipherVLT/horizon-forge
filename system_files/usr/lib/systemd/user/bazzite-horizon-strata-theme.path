[Unit]
Description=Watch GTK theme settings for Strata

[Path]
PathChanged=%h/.config/gtk-3.0/settings.ini
PathChanged=%h/.config/gtk-4.0/settings.ini
PathChanged=%h/.config/gtk-3.0/gtk.css
PathChanged=%h/.config/gtk-4.0/gtk.css
PathChanged=%h/.config/dconf/user
Unit=bazzite-horizon-strata-theme.service

[Install]
WantedBy=default.target
