#!/usr/bin/env bash
# App drawer (Super+A): every installed app in a grid (nwg-drawer).
# Super+A again, or Esc, closes it. Fuzzel search stays on Super+D.
# Look: ~/.config/nwg-drawer/drawer.css (copied from
# /usr/share/nwg-drawer/drawer.css the first time it opens).
if pgrep -x nwg-drawer >/dev/null; then
    exec pkill -x nwg-drawer
fi
exec nwg-drawer -term kitty -fm strata -ovl -c 6 -is 64 -spacing 20 "$@"
