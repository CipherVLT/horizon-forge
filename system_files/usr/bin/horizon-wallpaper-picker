#!/usr/bin/env bash
# Wallpaper picker (Super+Shift+W): the images in ~/Pictures/Wallpapers and
# Bazzite's own wallpapers, in fuzzel. The one you pick becomes Event
# Horizon's wallpaper (also in Settings > Wallpaper).
set -euo pipefail

pictures=$(xdg-user-dir PICTURES 2>/dev/null || echo "${HOME}/Pictures")
walls="${pictures}/Wallpapers"
mkdir -p "${walls}"

mapfile -t images < <(
    find "${walls}" /usr/share/wallpapers /usr/share/backgrounds -maxdepth 3 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        2>/dev/null | sort
)

if (( ${#images[@]} == 0 )); then
    printf '%s\n' "No images yet: put wallpapers in ${walls}" |
        fuzzel --dmenu --prompt 'wallpaper > ' --lines 1 --width 60 >/dev/null || true
    exit 0
fi

# Show "folder/name" so same-named files stay distinguishable.
label() { printf '%s/%s\n' "$(basename "$(dirname "$1")")" "$(basename "$1")"; }
choice=$(for img in "${images[@]}"; do label "${img}"; done |
    fuzzel --dmenu --prompt 'wallpaper > ' --width 50) || exit 0

for img in "${images[@]}"; do
    if [[ "$(label "${img}")" == "${choice}" ]]; then
        exec horizon-wallpaper --set "${img}"
    fi
done
