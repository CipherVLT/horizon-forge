#!/usr/bin/env bash
# Login-screen session: seed a Hyprland config the first time, then exec Hyprland.
# Event Horizon itself is started by exec-once inside that config.
set -euo pipefail

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Hyprland}"
export XDG_SESSION_TYPE=wayland

config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
skel=/usr/share/event-horizon/skel

mkdir -p "${config_home}/hypr/eh" "${config_home}/event-horizon"

if [[ ! -e "${config_home}/hypr/hyprland.conf" ]]; then
    cp "${skel}/hypr/hyprland.conf" "${config_home}/hypr/hyprland.conf"
fi

if [[ ! -e "${config_home}/hypr/eh/colors.conf" ]]; then
    cp "${skel}/hypr/eh/colors.conf" "${config_home}/hypr/eh/colors.conf"
fi

exec /usr/bin/Hyprland
