#!/usr/bin/env bash
# Login-screen session: seed a Hyprland config the first time, then exec Hyprland.
# Event Horizon itself is started from that config (hyprland.start).
set -euo pipefail

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Hyprland}"
export XDG_SESSION_TYPE=wayland

# Start everything from $HOME as spelled in /etc/passwd, so terminals open in
# ~ instead of its resolved path (/var/home/<user> on Fedora atomic).
cd "${HOME}" || true

config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
skel=/usr/share/event-horizon/skel

mkdir -p "${config_home}/hypr/eh" "${config_home}/Event-Horizon"

# Hyprland reads only Lua configs from 0.57 on, and 0.56 already prefers
# hyprland.lua over hyprland.conf. Seed the Lua config once; an older
# hyprland.conf is left in place (unused) for reference.
hypr_lua="${config_home}/hypr/hyprland.lua"
if [[ ! -e "${hypr_lua}" ]]; then
    cp "${skel}/hypr/hyprland.lua" "${hypr_lua}"
else
    # Still an unedited copy of an older default? Then nothing of yours is
    # in it: replace it with the current default so image updates reach it.
    # A config you have changed is never touched.
    current=$(sha256sum "${hypr_lua}" | cut -d' ' -f1)
    if grep -qx "${current}" "${skel}/hypr/previous-defaults.sha256" 2>/dev/null; then
        cp "${skel}/hypr/hyprland.lua" "${hypr_lua}"
    fi
fi

# First login: point Event Horizon at a wallpaper so the desktop is not an
# empty grey surface. Only written when the user has no shell settings yet;
# after that the shell's own Wallpaper settings own the file. Home folders
# from the old C++ Event Horizon (~/.config/event-horizon/config.toml) keep
# the wallpaper they had picked.
eh_settings="${config_home}/Event-Horizon/settings.toml"
old_eh_config="${config_home}/event-horizon/config.toml"
wallpaper=/usr/share/wallpapers/convergence.png
if [[ -f "${old_eh_config}" ]]; then
    old_image=$(awk -F'"' '/^\[/{s=$0} s=="[wallpaper]" && /^image[ \t]*=/{print $2; exit}' "${old_eh_config}")
    if [[ -n "${old_image}" && -f "${old_image}" ]]; then
        wallpaper="${old_image}"
    fi
fi
if [[ ! -e "${eh_settings}" && -f "${wallpaper}" ]]; then
    printf '[wallpaper]\nenabled = true\nmode = 0\nimage = "%s"\n' "${wallpaper}" > "${eh_settings}"
fi

# Bazzite's installer copies a silent Steam autostart entry into every new
# user's ~/.config/autostart, so Steam opens at each login. The image no
# longer ships it; remove the copy already in the home folder, once. If you
# later turn on Steam's own "Run Steam when my computer starts", Steam
# writes a new entry and this does not touch it again.
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/bazzite-horizon"
if [[ ! -e "${state_dir}/steam-autostart-removed" ]]; then
    steam_autostart="${config_home}/autostart/steam.desktop"
    if [[ -f "${steam_autostart}" ]] && grep -q -- '-silent' "${steam_autostart}"; then
        rm -f "${steam_autostart}"
    fi
    mkdir -p "${state_dir}"
    : > "${state_dir}/steam-autostart-removed"
fi

# GPU environment, regenerated at every login from the hardware that is
# present, so one image works on an AMD desktop and an Intel+NVIDIA laptop
# alike. hyprland.lua runs it first; put your own overrides further down in
# hyprland.lua. Do not edit gpu.lua, it is replaced.
gpu_lua="${config_home}/hypr/eh/gpu.lua"
rm -f "${config_home}/hypr/eh/gpu.conf"
{
    echo "-- Generated by event-horizon-session at login. Do not edit."
    nvidia=""
    other=""
    for card in /sys/class/drm/card[0-9]*; do
        [[ -e "${card}/device/vendor" ]] || continue
        vendor=$(<"${card}/device/vendor")
        node="/dev/dri/$(basename "${card}")"
        case "${vendor}" in
            0x10de) nvidia="${nvidia:+${nvidia}:}${node}" ;;
            *)      other="${other:+${other}:}${node}" ;;
        esac
    done
    if [[ -n "${nvidia}" && -z "${other}" ]]; then
        # NVIDIA only: everything runs on it. https://wiki.hypr.land/Nvidia/
        echo 'hl.env("LIBVA_DRIVER_NAME", "nvidia")'
        echo 'hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")'
        echo 'hl.env("NVD_BACKEND", "direct")'
        echo 'hl.config({ cursor = { no_hardware_cursors = true } })'
    elif [[ -n "${nvidia}" ]]; then
        # Hybrid laptop: the desktop, browser and video decoding stay on the
        # integrated GPU so the NVIDIA card can sleep. Games reach it through
        # Cardwire (ujust horizon-gpu). Forcing the NVIDIA GL/VA-API drivers
        # here would keep it awake all the time. Its outputs (often HDMI)
        # still work: Hyprland drives them as a secondary GPU.
        echo "hl.env(\"AQ_DRM_DEVICES\", \"${other}:${nvidia}\")"
        echo 'hl.config({ cursor = { no_hardware_cursors = true } })'
    fi
} > "${gpu_lua}"

# Event Horizon saves an icon index in ~/.cache and reuses it while the icon
# folders' modification times are unchanged. Everything under /usr has the
# same fixed timestamp on this system (ostree), so apps added later with
# rpm-ostree or `ujust horizon-install` (ROG Control Center, Discord, ...)
# showed up greyed out without an icon. Drop the index whenever the set of
# installed icon files changes; Event Horizon rebuilds it on start.
icon_index="${XDG_CACHE_HOME:-${HOME}/.cache}/Event-Horizon/icon-index"
icon_state="${HOME}/.local/state/bazzite-horizon/icon-files"
icon_fp=$(ls -R /usr/share/icons /usr/share/pixmaps /usr/local/share/icons \
    /var/lib/flatpak/exports/share/icons "${HOME}/.local/share/icons" 2>/dev/null | md5sum) || true
if [[ "$(cat "${icon_state}" 2>/dev/null)" != "${icon_fp}" ]]; then
    rm -rf "${icon_index}"
    mkdir -p "$(dirname "${icon_state}")"
    printf '%s\n' "${icon_fp}" > "${icon_state}"
fi

# Strata draws its own colors; match them to the GTK theme (also re-run by
# bazzite-horizon-strata-theme.path when the theme changes).
/usr/libexec/bazzite-horizon-strata-theme >/dev/null 2>&1 &

# start-hyprland is Hyprland's own launcher (crash recovery, safe mode);
# starting the compositor binary directly triggers a startup warning.
if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland
fi
exec /usr/bin/Hyprland
